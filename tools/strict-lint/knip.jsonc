{
  // What knip reads in this project. This file is the project's: when a package
  // gets an entry knip cannot see, name it here.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // The root package is tooling. `tools/` holds installed copies (the kit,
      // the add-ons), so every script there is an entry: nothing in it is
      // reported, and what it imports counts as used.
      "entry": ["architecture.config.mts", "tools/**/*.mts"],
      "project": ["*.mts", "tools/**/*.mts"],
      // The repo-hygiene add-on keeps its stylelint rules here, not at the root:
      // the project's file, and the base it extends. knip does not follow that
      // `extends` to a file, so both are named, or the packages the base
      // loads would read as unused.
      "stylelint": {
        "config": ["tools/repo-hygiene/stylelint.json", "tools/repo-hygiene/stylelint.base.json"]
      },
      // Run as a program by a script in tools/, which starts it by its name in
      // a string. knip follows imports and package.json scripts, not that.
      // dependency-cruiser: the kit's dependencies gate. The next three: the
      // repo-hygiene add-on's checks.
      // The last two are not the root's at all: the kit's check-compiler.mts
      // loads them from the client package, to judge with the compiler the
      // build runs. knip reads that as an import by the root.
      "ignoreDependencies": [
        "dependency-cruiser",
        "@manypkg/cli",
        "stylelint",
        "syncpack",
        "@babel/core",
        "babel-plugin-react-compiler"
      ],
      // The visual add-on's scripts here run Playwright in the package that
      // installs it (`pnpm --dir packages/client-react exec playwright`). knip
      // reads them as run at the root, where Playwright is not a dependency.
      "ignoreBinaries": ["playwright"],
      // The root has no tests: each package runs its own. vitest is a root
      // devDependency, so knip's vitest plugin would take every `*.test.*`
      // outside packages/ as a root entry, and the only ones are in
      // old/prototype-web (the archived prototype, in no workspace and no
      // build): 70 of its imports read as unlisted dependencies.
      "vitest": { "entry": [] }
    },
    "packages/*": {
      // A package's `exports` map (`./*` to `./src/*`) makes every file under
      // src/ an entry, and knip does not judge the exports of an entry unless
      // told to. Without this line no export of a library package is ever
      // reported. With it, every export needs an importer: a file in the
      // package, a test, or another package.
      "includeEntryExports": true,
      // A Playwright tier and the Vite host it serves keep their configs under
      // tests/ (the visual add-on does), where knip does not look by default.
      "playwright": { "config": ["playwright.config.ts", "tests/**/playwright.config.ts"] },
      "vite": { "config": ["vite.config.ts", "tests/**/vite.config.ts"] }
    },
    // A workspace named here replaces "packages/*" for that package (knip does
    // not merge the two), so each repeats `includeEntryExports`.
    "packages/db": {
      // The ETL and reset are run as programs by package.json scripts
      // (`node etl/index.ts`, `node scripts/reset.mts`). drizzle-kit reads
      // drizzle.config.ts; knip's drizzle plugin finds it, so it is not named
      // here (as an entry its default export would read as unused).
      "entry": ["etl/index.ts", "scripts/reset.mts"],
      "includeEntryExports": true,
      "project": ["src/**/*.ts", "etl/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/legacy-import": {
      // The generator is run as a program (`node src/generate-data.ts`), and
      // so is the history-rewrite mapping exporter (`node
      // src/pseudonymise/exportMapping.ts <out-file>`, by hand, never by a
      // script); the parity specs live outside src/.
      "entry": [
        "src/generate-data.ts",
        "src/pseudonymise/exportMapping.ts",
        "specs/**/*.test.ts"
      ],
      "includeEntryExports": true,
      "project": ["src/**/*.ts", "specs/**/*.ts"]
    }
  }
}
