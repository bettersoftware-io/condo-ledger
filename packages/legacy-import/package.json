{
  "name": "@cl/legacy-import",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "gen:data": "node src/generate-data.ts",
    "gen:oracle-fixture": "node src/oracle/writeFixture.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --no-fsModuleCache"
  },
  "dependencies": {
    "@cl/db": "workspace:*",
    "@cl/domain": "workspace:*"
  }
}
