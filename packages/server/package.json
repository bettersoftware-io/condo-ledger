{
  "name": "@cl/server",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
