{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./tools/format-lint/biome.base.json"],
  "files": {
    "includes": [
      "!tools",
      "!.*",
      "!.claude",
      "!.codex",
      "!**/dist",
      "!**/coverage",
      "!**/reports",
      "!**/.turbo",
      "!old",
      "!docs",
      "!packages/legacy-import/seed"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/db/**", "packages/legacy-import/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "nursery": {
            "useExplicitType": "off"
          }
        }
      }
    }
  ]
}
