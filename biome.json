{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./tools/format-lint/biome.base.json"],
  "files": {
    "includes": [
      "!tools",
      "!.*",
      "!.claude",
      "!.codex",
      "!**/dist",
      "!**/coverage",
      "!**/reports",
      "!**/.turbo",
      "!old",
      "!docs",
      "!packages/legacy-import/seed",
      "!packages/domain/src/simulators/seed/legacySeed.generated.ts",
      "!packages/db/drizzle"
    ]
  },
  "overrides": [
    {
      "includes": [
        "packages/client-react/src/ui/TreeGrid.tsx",
        "packages/client-react/src/ui/TreeGridRow.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/db/**", "packages/legacy-import/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "nursery": {
            "useExplicitType": "off"
          }
        }
      }
    }
  ]
}
