{
  "name": "condo-ledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @cl/client-react dev",
    "dev:server": "pnpm --filter @cl/server dev",
    "dev:fs": "VITE_SERVER_URL=ws://localhost:4000/ws turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.tooling.json",
    "test": "turbo run test",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "gates": "node tools/arch/gates/run.mts",
    "check:react-policies": "node tools/arch/check-react-policies.mts",
    "check:compiler": "node tools/arch/check-compiler.mts",
    "gate:fast": "pnpm gates && pnpm check:react-policies && pnpm check:compiler && pnpm lint && pnpm typecheck && pnpm biome:check && pnpm lint:types && pnpm lint:dead && pnpm check:dockerfiles && pnpm visual:check && pnpm visual:check:server && pnpm check:versions && pnpm check:doc-links && pnpm lint:css && pnpm check:status && pnpm visual:check:styles",
    "gate:full": "pnpm gate:fast && pnpm test && pnpm build && pnpm coverage",
    "gate:fast:quiet": "node tools/arch/gates/quiet.mts gate:fast",
    "gate:full:quiet": "node tools/arch/gates/quiet.mts gate:full",
    "biome:format": "biome format --write .",
    "biome:fix": "biome check --write .",
    "biome:check": "biome ci --error-on-warnings .",
    "fix": "node tools/format-lint/fix.mts",
    "lint:types": "node tools/strict-lint/check-types.mts",
    "lint:dead": "node tools/strict-lint/check-dead.mts",
    "coverage": "node tools/coverage/run.mts",
    "coverage:gaps": "node tools/coverage/gaps.mts",
    "mutation-check": "node tools/coverage/mutation-check.mts",
    "lint:workflows": "node tools/ci-security/lint-workflows.mts",
    "check:dockerfiles": "node tools/ci-security/check-dockerfiles.mts",
    "visual": "pnpm --dir packages/client-react exec playwright test --config tests/visual/playwright.config.ts",
    "visual:update": "pnpm --dir packages/client-react exec playwright test --config tests/visual/playwright.config.ts --update-snapshots=all",
    "visual:jitter": "node tools/visual/jitter.mts",
    "visual:check": "pnpm --dir packages/client-react run typecheck:visual",
    "visual:check:server": "node tools/visual/check-server.mts",
    "worktree": "node tools/agent-workflow/new-worktree.mts",
    "changelog": "node tools/agent-workflow/changelog.mts",
    "agent-workflow:check": "node tools/agent-workflow/check.mts",
    "repo:settings": "node tools/ci-security/check-settings.mts",
    "check:versions": "node tools/repo-hygiene/check-versions.mts",
    "check:doc-links": "node tools/repo-hygiene/check-doc-links.mts",
    "lint:css": "node tools/repo-hygiene/check-css.mts",
    "worktree:audit": "node tools/agent-workflow/audit-worktrees.mts",
    "check:status": "node tools/agent-workflow/check-status.mts",
    "visual:check:styles": "node tools/visual/check-styles.mts",
    "visual:coverage": "node tools/visual/coverage.mts",
    "changelog:releases": "node tools/agent-workflow/sync-releases.mts",
    "e2e": "node tools/e2e/run.mts",
    "e2e:install": "pnpm --dir packages/e2e exec playwright install chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@manypkg/cli": "^0.25.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/utils": "^8.70.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.17.1",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "syncpack": "^15.3.2",
    "turbo": "^2.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.3"
  }
}
